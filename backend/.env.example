# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# --- Database ---
# Uncomment to use a local file instead of PostgreSQL (nothing to install):
# DB_ENGINE=sqlite

# --- PostgreSQL ---
POSTGRES_DB=fraud_detection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Alerts ---
# Development default: emails and SMS are printed in the terminal, nothing is sent.
# To send real email, use the SMTP backend and fill in your mail server details:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@example.com
#   EMAIL_HOST_PASSWORD=app-password
#   DEFAULT_FROM_EMAIL=Fraud Alerts <alerts@yourdomain.com>
# To send real SMS, use Termii (needs an API key and a sender ID registered with Termii):
#   SMS_BACKEND=termii
#   TERMII_API_KEY=your-key
#   TERMII_SENDER_ID=YourSenderID
#
# Zoho Mail (works from your own computer; NOT from free Render, which blocks SMTP ports):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.zoho.com          (smtppro.zoho.com for a paid, domain-based Zoho account)
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@zohomail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   DEFAULT_FROM_EMAIL=Fraud Alerts <you@zohomail.com>   (must be your own Zoho address)
# Email over HTTPS (works from free Render):
#   EMAIL_BACKEND=alerts.email_backends.ResendEmailBackend
#   RESEND_API_KEY=re_...
#   DEFAULT_FROM_EMAIL=Fraud Alerts <onboarding@resend.dev>
# Demo: deliver EVERY alert to one inbox / phone instead of the (made-up) account addresses:
#   ALERT_EMAIL_REDIRECT=you@zohomail.com
#   ALERT_SMS_REDIRECT=+234XXXXXXXXXX
SMS_BACKEND=console
# Where the React dashboard runs (used for links inside alert emails)
FRONTEND_URL=http://localhost:5173
# Send alerts in a background thread so the API stays fast
ALERTS_ASYNC=true
# Load the trained model when runserver starts
FRAUD_WARMUP=true

# --- Hosting (Render) ---
# On Render these are set on the website, not in this file:
#   DATABASE_URL, DJANGO_SECRET_KEY, DJANGO_DEBUG=false, DEMO_PASSWORD,
#   CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app, FRONTEND_URL=https://your-dashboard.vercel.app
