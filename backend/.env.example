# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django ---
   DJANGO_SECRET_KEY=any-long-random-text-you-type-here-1234567890
   DJANGO_DEBUG=True
   DB_ENGINE=sqlite
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=fraud_detection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Alerts ---
# Development default: emails and SMS are printed in the terminal, nothing is sent.
# To send real email, use the SMTP backend and fill in your mail server details:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@example.com
#   EMAIL_HOST_PASSWORD=app-password
#   DEFAULT_FROM_EMAIL=Fraud Alerts <alerts@yourdomain.com>
# To send real SMS, use Termii (needs an API key and a sender ID registered with Termii):
#   SMS_BACKEND=termii
#   TERMII_API_KEY=your-key
#   TERMII_SENDER_ID=YourSenderID
SMS_BACKEND=console
# Where the React dashboard runs (used for links inside alert emails)
FRONTEND_URL=http://localhost:5173
# Send alerts in a background thread so the API stays fast
ALERTS_ASYNC=true
# Load the trained model when runserver starts
FRAUD_WARMUP=true
